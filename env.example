DISCORD_BOT_TOKEN=your-discord-bot-token-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: comma-separated channel IDs to restrict the bot to. Leave blank to allow every channel it can see.
ALLOWED_CHANNEL_IDS=

# Required for the !update command (publishing hub/itinerary edits).
# Fine-grained GitHub personal access token, scoped to just this repo, with Contents: Read and write.
GITHUB_TOKEN=your-github-personal-access-token-here
# owner/repo the bot is deployed from - only change this if you forked/renamed it.
GITHUB_REPO=Roleseee/japan-trip-bot
# Comma-separated Discord user IDs allowed to request/confirm !update edits.
AUTHORIZED_USER_IDS=
